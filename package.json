{
    "name": "marktperspectief",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "next dev --hostname localhost",
        "build": "next build",
        "start": "next start",
        "lint": "biome check && eslint",
        "format": "biome check --write && eslint --fix",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run",
        "mcp": "tsx src/mcp/stdio.ts",
        "eval": "tsx evals/run.ts",
        "db:studio": "drizzle-kit studio",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "mkdir -p .data && drizzle-kit migrate && pnpm db:seed",
        "db:seed": "tsx scripts/seed.ts",
        "db:rebuild": "tsx --env-file=.env.local scripts/rebuild.ts",
        "db:sync": "tsx scripts/sync.ts",
        "db:demo": "pnpm db:migrate && tsx scripts/demo.ts",
        "db:check": "drizzle-kit check",
        "auth:schema": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes"
    },
    "dependencies": {
        "@better-auth/cimd": "1.7.14",
        "@better-auth/mcp": "1.7.14",
        "@better-auth/oauth-provider": "1.7.14",
        "@better-auth/passkey": "1.7.14",
        "@libsql/client": "^0.18.0",
        "@modelcontextprotocol/ext-apps": "2.1.0",
        "@modelcontextprotocol/server": "2.4.0",
        "@vercel/blob": "2.8.2",
        "better-auth": "1.7.14",
        "cn": "^0.5.0",
        "drizzle-orm": "0.45.4",
        "next": "16.4.6",
        "papaparse": "5.7.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "read-excel-file": "9.3.12",
        "recharts": "3.10.1",
        "yahoo-finance2": "4.0.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "1.12.0",
        "@biomejs/biome": "2.5.15",
        "@modelcontextprotocol/client": "2.4.0",
        "@tailwindcss/turbopack": "^4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^22",
        "@types/papaparse": "5.5.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "auth": "1.7.14",
        "drizzle-kit": "0.31.11",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "jsdom": "31.0.1",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "5.0.5"
    },
    "packageManager": "pnpm@10.5.2"
}
