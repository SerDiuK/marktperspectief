{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "regions": ["dub1"],
    "buildCommand": "if [ \"$VERCEL_ENV\" = production ]; then pnpm db:migrate; fi && pnpm build",
    "crons": [
        {
            "path": "/api/cron/daily",
            "schedule": "0 22 * * *"
        },
        {
            "path": "/api/cron/daily",
            "schedule": "0 5 * * *"
        }
    ]
}
