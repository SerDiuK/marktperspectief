# Copy to .env.local, or let `vercel env pull` write it. Local runs need none of
# these: the database is .data/dev.db and raw files go to .data/blob/.

# Turso, used only on Vercel (production and preview)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob for the raw exports; without it they stay in .data/blob/
BLOB_READ_WRITE_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Lets /login?setup register the owner's passkey; remove it once that is done
AUTH_SETUP_TOKEN=

# Sent by Vercel cron to /api/cron/daily
CRON_SECRET=

# The owner's display name and the time zone that decides today's date
OWNER_NAME=
OWNER_TIME_ZONE=Europe/Madrid

# Claude for the holding panel's Ask button, which doesn't show without it. The demo
# gets its own key, from a workspace with a spend limit.
ANTHROPIC_API_KEY=

# 1 on the public demo: "Enter the demo" signs visitors in, and the daily cron
# reloads the demo. Both refuse a database that holds anything else.
DEMO_MODE=
